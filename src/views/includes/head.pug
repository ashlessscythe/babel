head
    include seo.pug
    meta(name="viewport", content="width=device-width, initial-scale=1")
    meta(name="theme-color", content="#0a0a0a")
    meta(name="color-scheme", content="dark light")
    link(rel="icon", href="/image/favicon-white.png", type="image/png")
    link(rel="preload", href="/font/CloisterBlack.ttf", type="font/ttf", as="font", crossorigin=true)
    link(rel="stylesheet", href="/css/index.css")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin=true)
    link(rel="stylesheet", href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=IBM+Plex+Mono:wght@400;500&display=swap")
    script.
        (function () {
          try {
            var t = localStorage.getItem("the-library-theme");
            if (t !== "light" && t !== "dark") t = "dark";
            document.documentElement.setAttribute("data-theme", t);
          } catch (e) {
            document.documentElement.setAttribute("data-theme", "dark");
          }
        })();
    script(src="/js/theme.js", defer=true)
