doctype html
html(lang="en")
    include includes/head.pug
    +seo("The Library", "Every possible book exists here. Search the Library.")

    body
        include includes/nav.pug

        main.Home
            h1.HomeBrand The Library

            p.HomeLead Every possible book exists here.

            form.HomeSearch.SearchForm
                label(for="content") Search the Library
                textarea#content(name="content", rows=3, required=true, placeholder="Enter a sentence, a name, a date…", autofocus=true)
                input(type="hidden", name="mode", value="empty")
                button(type="submit") Search

            nav.HomeActions(aria-label="Primary actions")
                a(href="/random") Random Page
                a(href="/browse") Explore
                a(href="/about") About

            if bookmarkCount
                p.HomeMeta #{bookmarkCount.toLocaleString()} rooms remembered

        include includes/footer.pug

    script(src="/js/handleSearchForm.js", type="text/javascript")
