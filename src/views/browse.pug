doctype html
html(lang="en")
    include includes/head.pug
    +seo("Explore the Library", "Enter coordinates. Walk to a room, wall, shelf, book, and page.")

    body
        include includes/nav.pug

        main
            img.CharcoalArt.CharcoalArt--banner(src="/image/art/explore-shelves.jpg", alt="Charcoal silhouette of a figure beside endless shelves")

            h2(style="font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.12em; text-transform: uppercase; margin-bottom: 1rem; font-weight: 400;") Enter the coordinates

            form#browse.BrowseForm
                label
                    p Room
                    textarea(name="room", rows=2, required=true, placeholder="Base-32 room id: 0-9 and a-v")

                div.Numbers
                    label
                        p Wall
                            |
                            |
                            span 1-4
                        input(name="wall", type="number", min=1, max=4, value=1, required=true)

                    label
                        p Shelf
                            |
                            |
                            span 1-5
                        input(name="shelf", type="number", min=1, max=5, value=1, required=true)

                    label
                        p Book
                            |
                            |
                            span 1-32
                        input(name="book", type="number", min=1, max=32, value=1, required=true)

                    label
                        p Page
                            |
                            |
                            span 1-410
                        input(name="page", type="number", min=1, max=410, value=1, required=true)

                button Go

            div.Divider
                p OR

            form#bookmark.BrowseForm
                label
                    p Open a bookmark file
                        |
                        |
                        span .babel from a page you saved
                    input(type="file", name="bookmark", accept=".babel", multiple=false, required=true)

                button Go

        include includes/footer.pug

    script(src="/js/handleBrowseForm.js", type="text/javascript")
    script(src="/js/handleBookmarkForm.js", type="text/javascript")
