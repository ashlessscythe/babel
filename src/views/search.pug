doctype html
html(lang="en")
    include includes/head.pug
    +seo("Search the Library", "Any text you can invent already exists somewhere in the Library. Find its coordinate.")

    body
        include includes/nav.pug

        main
            div.SearchGrid
                img.CharcoalArt.CharcoalArt--side(src="/image/art/search-scribe.jpg", alt="Charcoal stencil of a scribe reading by lamp-light")

                div.BodyStyle
                    h2 Search the Library
                    p.initial
                        span Any
                        |
                        | text you can invent already exists somewhere here. The Library does not store books — it computes them.
                    p Finding a sentence proves only that a book containing it occupies a coordinate. It does not make the surrounding pages meaningful.

            hr.SectionRule

            form.SearchForm
                textarea(name="content", rows=8, required=true, placeholder="a-z . , ! ? - and spaces. Up to one full book.")
                div.ModeSelection
                    label
                        input(type="radio", name="mode", value="empty", checked=true)
                        | Empty page
                    label
                        input(type="radio", name="mode", value="emptybook")
                        | Empty book
                    label
                        input(type="radio", name="mode", value="chars")
                        | Random characters
                    label
                        input(type="radio", name="mode", value="words")
                        | Random words
                button Search

        include includes/footer.pug

    script(src="/js/handleSearchForm.js", type="text/javascript")
